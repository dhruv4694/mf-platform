# .env.example — copy this to .env and fill in real values
# NEVER commit .env to git — add it to .gitignore
#
# Used by: docker compose -f compose.prod.yml up -d

# Database password (used by PostgreSQL and the app)
DB_PASSWORD=YourSecureDBPassword!

# JWT signing secret — must be at least 32 characters
JWT_SECRET=your-production-secret-key-minimum-32-characters-long

# Admin account created on first startup by DataSeeder
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=YourSecureAdminPassword123!

# Email — leave all MAIL_* unset to keep using the bundled MailHog (no real
# emails sent, view them at http://localhost:8025). To send real emails via
# Gmail: enable 2-Step Verification on the Gmail account, generate an App
# Password at https://myaccount.google.com/apppasswords (NOT your regular
# Gmail password), then set:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=youraddress@gmail.com
#   MAIL_PASSWORD=<the 16-character App Password, no spaces>
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS=true
#   NOTIFICATION_EMAIL_FROM=youraddress@gmail.com   (must match MAIL_USERNAME — Gmail rejects/overrides a From that isn't the authenticated account)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
NOTIFICATION_EMAIL_FROM=
