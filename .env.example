# .env.example — copy this to .env and fill in real values
# NEVER commit .env to git — add it to .gitignore
#
# Used by: docker compose -f compose.prod.yml up -d

# Database password (used by PostgreSQL and the app)
DB_PASSWORD=YourSecureDBPassword!

# JWT signing secret — must be at least 32 characters
JWT_SECRET=your-production-secret-key-minimum-32-characters-long

# Admin account created on first startup by DataSeeder
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=YourSecureAdminPassword123!
